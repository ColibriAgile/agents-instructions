# skills.yaml — manifesto de skills do projeto
# Copie para a raiz do projeto como skills.yaml e faça commit. Depois rode, na raiz do projeto:
#   node <clone do agents-instructions>/bin/colibri-skills.mjs install
# (ou use o painel Skills do mod skill-bundles do Herdr).
#
# bundles: grupos de skills do bundles.yaml do catálogo. O core entra em todo projeto.
# skills:  skills do catálogo que não estão nos bundles do projeto (opcional).
# sources: skills de outros repositórios (opcional).

bundles:
  - core
  - dotnet
  - code-review

skills:
  - colibri-design-kit

sources:
  - repo: pedronauck/skills
    skills:
      - deslop
      - refactoring-analysis
