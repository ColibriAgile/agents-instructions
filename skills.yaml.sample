# skills.yaml
# Modelo para uso com Install-Skills.ps1
#
# "bundles" referencia nomes definidos em bundles.yaml (ColibriAgile/agents-instructions).
# Todo projeto deve declarar pelo menos o bundle "core" + o(s) bundle(s) de stack/temática
# que fizerem sentido. Install-Skills.ps1 resolve cada bundle na lista real de skills.
#
# "sources" continua existindo para skills avulsas (não cobertas por nenhum bundle) ou
# vindas de outros repositórios GitHub.

bundles:
  - core
  - dotnet
  - code-review

sources:
  - repo: pedronauck/skills/skills/mine
    skills:
      - deslop
      - refactoring-analysis
