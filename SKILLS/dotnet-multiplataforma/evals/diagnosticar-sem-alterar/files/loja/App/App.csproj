<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>D:\sistema\loja\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\lib\Lib.csproj" />
  </ItemGroup>
  <Target Name="CopiarModelos" AfterTargets="Build">
    <Exec Command="xcopy &quot;Modelos\*.*&quot; &quot;$(OutputPath)Modelos\&quot; /I /Y" />
  </Target>
</Project>
