<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- AJUSTE: o nome do assembly do InternalsVisibleTo das telas (dá acesso aos membros internal). Sem acesso, use Capturas. -->
    <AssemblyName>CoLib.Payment.Ui.Testes</AssemblyName>
    <!-- AJUSTE: o mesmo TargetFramework e o mesmo PlatformTarget dos projetos das telas. -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- AJUSTE: a mesma versão do pacote Avalonia dos projetos das telas. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <!-- AJUSTE: caminho absoluto de cada projeto que tem telas. -->
    <ProjectReference Include="D:/Projetos/payment/_lib/CoLib.Payment.Configurador/CoLib.Payment.Configurador.csproj" />
  </ItemGroup>
</Project>
