{
  "name": "@colibriagile/agents-instructions",
  "version": "0.1.0",
  "description": "Interactive, cross-platform installer for Colibri agent skills and bundles",
  "type": "module",
  "license": "MIT",
  "repository": "github:ColibriAgile/agents-instructions",
  "bin": { "colibri-skills": "bin/colibri-skills.mjs" },
  "files": ["bin/", "dist/", "SKILLS/", "bundles.yaml", "skill-requirements.yaml", "LICENSE", "README.md"],
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "build": "tsc",
    "start": "node bin/colibri-skills.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "skills": "1.7.4",
    "yaml": "2.9.1"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.9.3" }
}
