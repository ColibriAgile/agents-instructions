{
  "name": "@colibriagile/agents-instructions",
  "version": "0.1.0",
  "description": "Interactive, cross-platform manager for Colibri agent skills and bundles: links from a project to this clone",
  "type": "module",
  "license": "MIT",
  "repository": "github:ColibriAgile/agents-instructions",
  "bin": {
    "colibri-skills": "bin/colibri-skills.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "engine/",
    "SKILLS/",
    "bundles.yaml",
    "skill-requirements.yaml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/colibri-skills.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "engine:sync": "node scripts/engine-sync.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
